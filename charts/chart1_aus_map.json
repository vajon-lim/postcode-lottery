{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 400,
  "background": null,
  "config": {
    "font": "Source Sans 3, system-ui, sans-serif",
    "view": {"stroke": null}
  },
  "projection": {"type": "mercator"},
  "data": {
    "url": "data/aus_states.geojson",
    "format": {"type": "json", "property": "features"}
  },
  "transform": [
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {"url": "data/medical_per_state.csv"},
        "key": "state_name",
        "fields": ["medical_per_100k", "state_abbr", "medical_fte"]
      }
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "#ffffff",
    "strokeWidth": 1.5
  },
  "encoding": {
    "color": {
      "field": "medical_per_100k",
      "type": "quantitative",
      "scale": {
        "scheme": "blues",
        "domain": [400, 580]
      },
      "legend": {
        "title": "Medical practitioners\nper 100,000 people",
        "orient": "bottom-right",
        "titleFont": "Source Sans 3, system-ui, sans-serif",
        "labelFont": "Source Sans 3, system-ui, sans-serif",
        "gradientLength": 120
      }
    },
    "tooltip": [
      {"field": "properties.STATE_NAME", "title": "State / Territory"},
      {"field": "state_abbr", "title": "Code"},
      {"field": "medical_per_100k", "title": "Medical practitioners per 100k", "format": ".1f"},
      {"field": "medical_fte", "title": "Total medical FTE", "format": ",.0f"}
    ]
  }
}
