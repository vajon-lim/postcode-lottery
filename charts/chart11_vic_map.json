{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 420,
  "background": null,
  "config": {
    "font": "Source Sans 3, system-ui, sans-serif",
    "view": {"stroke": null}
  },
  "projection": {
    "type": "mercator",
    "fit": false,
    "center": [145.469, -36.613],
    "scale": 2980
  },
  "data": {
    "url": "data/vic_sa3.geojson?v=2",
    "format": {"type": "json", "property": "features"}
  },
  "mark": {
    "type": "geoshape",
    "stroke": "#ffffff",
    "strokeWidth": 0.5
  },
  "encoding": {
    "color": {
      "condition": {
        "test": "datum.properties.ed_asr_per_100k == null",
        "value": "#d9d9d9"
      },
      "field": "properties.ed_asr_per_100k",
      "type": "quantitative",
      "scale": {
        "type": "quantile",
        "scheme": "plasma"
      },
      "legend": {
        "title": "ED visits per 100,000 people",
        "orient": "bottom-right",
        "titleFont": "Source Sans 3, system-ui, sans-serif",
        "labelFont": "Source Sans 3, system-ui, sans-serif",
        "format": ",.0f"
      }
    },
    "tooltip": [
      {"field": "properties.sa3_name_2021", "title": "Area"},
      {"field": "properties.sa4_name_2021", "title": "Region"},
      {"field": "properties.ed_asr_per_100k", "title": "ED visits per 100k (age-standardised)", "format": ",.0f"},
      {"field": "properties.poor_health_pct", "title": "% reporting poor/fair health", "format": ".1f"}
    ]
  }
}
