{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 260,
  "background": null,
  "config": {
    "font": "Source Sans 3, system-ui, sans-serif",
    "view": {"stroke": null}
  },
  "data": {"url": "data/gp_access_difficulty.csv"},
  "layer": [
    {
      "mark": {"type": "area", "opacity": 0.85, "line": {"strokeWidth": 1.5}},
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "axis": {
            "title": null,
            "labelFont": "Source Sans 3, system-ui, sans-serif",
            "labelFontSize": 10,
            "labelAngle": -30
          }
        },
        "y": {
          "field": "pct",
          "type": "quantitative",
          "stack": "zero",
          "axis": {
            "title": "% of people who needed GP care",
            "format": ".0f",
            "labelFont": "Source Sans 3, system-ui, sans-serif",
            "titleFont": "Source Sans 3, system-ui, sans-serif",
            "titleFontSize": 11
          }
        },
        "color": {
          "field": "barrier_type",
          "type": "nominal",
          "sort": ["Cost barrier", "Other barriers"],
          "scale": {
            "domain": ["Cost barrier", "Other barriers"],
            "range": ["#EE7733", "#88CCEE"]
          },
          "legend": {
            "title": "Barrier type",
            "titleFont": "Source Sans 3, system-ui, sans-serif",
            "labelFont": "Source Sans 3, system-ui, sans-serif"
          }
        },
        "order": {
          "field": "barrier_type",
          "sort": "ascending"
        },
        "tooltip": [
          {"field": "year", "title": "Year"},
          {"field": "barrier_type", "title": "Barrier type"},
          {"field": "pct", "title": "% of people who needed GP", "format": ".1f"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -4,
        "dy": -12,
        "fontSize": 9,
        "fontStyle": "italic",
        "color": "#CC5500"
      },
      "data": {"values": [{"year": "2023–24", "y": 8.8}]},
      "encoding": {
        "x": {"field": "year", "type": "ordinal"},
        "y": {"field": "y", "type": "quantitative"},
        "text": {"value": "8.8%: cost peak"}
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -4,
        "dy": 14,
        "fontSize": 9,
        "fontStyle": "italic",
        "color": "#888888"
      },
      "data": {"values": [{"year": "2020–21", "y": 2.4}]},
      "encoding": {
        "x": {"field": "year", "type": "ordinal"},
        "y": {"field": "y", "type": "quantitative"},
        "text": {"value": "COVID low: 2.4%"}
      }
    }
  ]
}
