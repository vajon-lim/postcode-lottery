{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 280,
  "background": null,
  "config": {
    "font": "Source Sans 3, system-ui, sans-serif",
    "view": {"stroke": null}
  },
  "data": {"url": "data/gp_rate_per_100k.csv"},
  "transform": [{"filter": "datum.year == 2023"}],
  "layer": [
    {
      "mark": {"type": "rule", "strokeDash": [4, 4], "strokeWidth": 1, "color": "#cccccc"},
      "data": {"values": [{"ref": 104.6}]},
      "encoding": {
        "x": {"field": "ref", "type": "quantitative", "axis": null}
      }
    },
    {
      "mark": {
        "type": "text",
        "text": "Major cities (104.6)",
        "align": "center",
        "dy": -6,
        "fontSize": 8,
        "fontStyle": "italic",
        "color": "#0077BB"
      },
      "data": {"values": [{"ref": 104.6}]},
      "encoding": {
        "x": {"field": "ref", "type": "quantitative"},
        "y": {"value": 0}
      }
    },
    {
      "mark": {"type": "rule", "strokeWidth": 2, "color": "#dddddd"},
      "encoding": {
        "y": {
          "field": "mm_label",
          "type": "ordinal",
          "sort": ["Major cities", "Large regional cities", "Medium rural towns", "Small rural towns", "Very small rural towns", "Remote communities", "Very remote communities"],
          "axis": {
            "title": null,
            "labelFont": "Source Sans 3, system-ui, sans-serif",
            "labelFontSize": 11
          }
        },
        "x": {"value": 0},
        "x2": {"field": "gp_rate_per_100k", "type": "quantitative"}
      }
    },
    {
      "mark": {"type": "point", "filled": true, "size": 120},
      "encoding": {
        "y": {
          "field": "mm_label",
          "type": "ordinal",
          "sort": ["Major cities", "Large regional cities", "Medium rural towns", "Small rural towns", "Very small rural towns", "Remote communities", "Very remote communities"]
        },
        "x": {
          "field": "gp_rate_per_100k",
          "type": "quantitative",
          "axis": {
            "title": "GP clinical FTE per 100,000 population",
            "labelFont": "Source Sans 3, system-ui, sans-serif",
            "titleFont": "Source Sans 3, system-ui, sans-serif",
            "titleFontSize": 11
          }
        },
        "color": {
          "field": "mm_label",
          "type": "nominal",
          "scale": {
            "domain": ["Major cities", "Large regional cities", "Medium rural towns", "Small rural towns", "Very small rural towns", "Remote communities", "Very remote communities"],
            "range": ["#0077BB", "#33BBEE", "#88CCEE", "#DDAA33", "#EE7733", "#CC5500", "#8B3A00"]
          },
          "legend": null
        },
        "tooltip": [
          {"field": "mm_label", "title": "MM Category"},
          {"field": "gp_rate_per_100k", "title": "GP FTE per 100k", "format": ".1f"},
          {"field": "year", "title": "Year"}
        ]
      }
    },
    {
      "mark": {"type": "point", "filled": false, "size": 320, "strokeWidth": 2.5, "color": "#EE7733"},
      "transform": [{"filter": "datum.mm_category == 'MM5'"}],
      "encoding": {
        "y": {
          "field": "mm_label",
          "type": "ordinal",
          "sort": ["Major cities", "Large regional cities", "Medium rural towns", "Small rural towns", "Very small rural towns", "Remote communities", "Very remote communities"]
        },
        "x": {"field": "gp_rate_per_100k", "type": "quantitative"}
      }
    },
    {
      "mark": {"type": "text", "align": "left", "dx": 14, "fontSize": 10, "baseline": "middle"},
      "encoding": {
        "y": {
          "field": "mm_label",
          "type": "ordinal",
          "sort": ["Major cities", "Large regional cities", "Medium rural towns", "Small rural towns", "Very small rural towns", "Remote communities", "Very remote communities"]
        },
        "x": {"field": "gp_rate_per_100k", "type": "quantitative"},
        "text": {"field": "gp_rate_per_100k", "format": ".1f"},
        "color": {
          "field": "mm_label",
          "type": "nominal",
          "scale": {
            "domain": ["Major cities", "Large regional cities", "Medium rural towns", "Small rural towns", "Very small rural towns", "Remote communities", "Very remote communities"],
            "range": ["#0077BB", "#33BBEE", "#88CCEE", "#DDAA33", "#EE7733", "#CC5500", "#8B3A00"]
          }
        }
      }
    },
    {
      "mark": {"type": "text", "align": "left", "dx": 44, "fontSize": 9, "fontStyle": "italic", "color": "#888888", "baseline": "middle"},
      "transform": [{"filter": "datum.mm_category == 'MM5'"}],
      "encoding": {
        "y": {
          "field": "mm_label",
          "type": "ordinal",
          "sort": ["Major cities", "Large regional cities", "Medium rural towns", "Small rural towns", "Very small rural towns", "Remote communities", "Very remote communities"]
        },
        "x": {"field": "gp_rate_per_100k", "type": "quantitative"},
        "text": {"value": "← lowest per-capita rate"}
      }
    }
  ]
}
