{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 200,
  "background": null,
  "config": {
    "font": "Source Sans 3, system-ui, sans-serif",
    "view": {
      "stroke": null
    }
  },
  "data": {
    "url": "data/service_access_difficulty.csv"
  },
  "mark": "rect",
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "axis": {
        "title": null,
        "labelFont": "Source Sans 3, system-ui, sans-serif",
        "labelFontSize": 11,
        "labelAngle": -30
      }
    },
    "y": {
      "field": "service",
      "type": "ordinal",
      "sort": ["After-Hours GP", "Dental", "Medical Specialist", "Hospital", "GP"],
      "axis": {
        "title": null,
        "labelFont": "Source Sans 3, system-ui, sans-serif",
        "labelFontSize": 11
      }
    },
    "color": {
      "field": "unmet_pct",
      "type": "quantitative",
      "scale": {
        "scheme": "oranges"
      },
      "legend": {
        "title": "% who couldn't\naccess care",
        "titleFont": "Source Sans 3, system-ui, sans-serif",
        "labelFont": "Source Sans 3, system-ui, sans-serif",
        "gradientLength": 100
      }
    },
    "tooltip": [
      {
        "field": "service",
        "title": "Service"
      },
      {
        "field": "year",
        "title": "Year"
      },
      {
        "field": "unmet_pct",
        "title": "% who needed but couldn't access",
        "format": ".1f"
      }
    ]
  }
}
