{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 320,
  "background": null,
  "config": {
    "font": "Source Sans 3, system-ui, sans-serif",
    "view": {
      "stroke": null
    }
  },
  "data": {
    "url": "data/workforce_remoteness.csv"
  },
  "transform": [
    {
      "filter": "datum.remoteness == 'Major Cities' || datum.remoteness == 'Outer Regional'"
    },
    {
      "calculate": "datum.remoteness == 'Major Cities' ? 0 : 1",
      "as": "x_pos"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2,
        "opacity": 0.7
      },
      "encoding": {
        "detail": {
          "field": "profession"
        },
        "x": {
          "field": "x_pos",
          "type": "ordinal",
          "scale": {
            "domain": [
              0,
              1
            ],
            "padding": 0.3
          },
          "axis": {
            "title": null,
            "labelExpr": "datum.value == 0 ? 'Major Cities' : 'Outer Regional'",
            "labelFont": "Source Sans 3, system-ui, sans-serif",
            "labelFontSize": 12,
            "labelFontWeight": "bold"
          }
        },
        "y": {
          "field": "fte",
          "type": "quantitative",
          "scale": {
            "type": "log"
          },
          "axis": {
            "title": "FTE (log scale)",
            "labelFont": "Source Sans 3, system-ui, sans-serif",
            "titleFont": "Source Sans 3, system-ui, sans-serif",
            "format": ",.0f",
            "titleFontSize": 11
          }
        },
        "color": {
          "field": "profession",
          "type": "nominal",
          "scale": {
            "range": [
              "#0077BB",
              "#33BBEE",
              "#EE7733",
              "#DDAA33",
              "#AA3377",
              "#009988",
              "#CC5500",
              "#555555"
            ]
          },
          "legend": {
            "title": "Profession",
            "titleFont": "Source Sans 3, system-ui, sans-serif",
            "labelFont": "Source Sans 3, system-ui, sans-serif",
            "orient": "right"
          }
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 80
      },
      "encoding": {
        "x": {
          "field": "x_pos",
          "type": "ordinal"
        },
        "y": {
          "field": "fte",
          "type": "quantitative",
          "scale": {
            "type": "log"
          }
        },
        "color": {
          "field": "profession",
          "type": "nominal",
          "scale": {
            "range": [
              "#0077BB",
              "#33BBEE",
              "#EE7733",
              "#DDAA33",
              "#AA3377",
              "#009988",
              "#CC5500",
              "#555555"
            ]
          }
        },
        "tooltip": [
          {
            "field": "profession",
            "title": "Profession"
          },
          {
            "field": "remoteness",
            "title": "Remoteness"
          },
          {
            "field": "fte",
            "title": "FTE",
            "format": ",.0f"
          },
          {
            "field": "headcount",
            "title": "Headcount",
            "format": ",.0f"
          }
        ]
      }
    }
  ]
}