{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 340,
  "background": null,
  "config": {
    "font": "Source Sans 3, system-ui, sans-serif",
    "view": {"stroke": null}
  },
  "data": {"url": "data/workforce_per_capita.csv"},
  "transform": [
    {"filter": "datum.remoteness == 'Major Cities' || datum.remoteness == 'Outer Regional'"}
  ],
  "layer": [
    {
      "mark": {"type": "line", "color": "#CCCCCC", "strokeWidth": 2.5},
      "encoding": {
        "x": {"field": "fte_per_100k", "type": "quantitative"},
        "y": {
          "field": "profession",
          "type": "ordinal",
          "sort": [
            "ATSI Health Practitioners",
            "Medical Practitioners",
            "Dental Practitioners",
            "Chiropractors",
            "Chinese Medicine Practitioners",
            "Paramedicine Practitioners",
            "Podiatrists",
            "Psychologists"
          ]
        },
        "detail": {"field": "profession"}
      }
    },
    {
      "mark": {"type": "point", "filled": true, "size": 110, "opacity": 0.9},
      "encoding": {
        "x": {
          "field": "fte_per_100k",
          "type": "quantitative",
          "axis": {
            "title": "FTE per 100,000 population",
            "labelFont": "Source Sans 3, system-ui, sans-serif",
            "titleFont": "Source Sans 3, system-ui, sans-serif",
            "format": ".0f",
            "titleFontSize": 11
          }
        },
        "y": {
          "field": "profession",
          "type": "ordinal",
          "sort": [
            "ATSI Health Practitioners",
            "Medical Practitioners",
            "Dental Practitioners",
            "Chiropractors",
            "Chinese Medicine Practitioners",
            "Paramedicine Practitioners",
            "Podiatrists",
            "Psychologists"
          ],
          "axis": {
            "title": null,
            "labelFont": "Source Sans 3, system-ui, sans-serif",
            "labelFontSize": 10
          }
        },
        "color": {
          "field": "remoteness",
          "type": "nominal",
          "scale": {
            "domain": ["Major Cities", "Outer Regional"],
            "range": ["#0077BB", "#EE7733"]
          },
          "legend": {
            "title": "Region",
            "orient": "top-right",
            "titleFont": "Source Sans 3, system-ui, sans-serif",
            "labelFont": "Source Sans 3, system-ui, sans-serif"
          }
        },
        "tooltip": [
          {"field": "profession", "title": "Profession"},
          {"field": "remoteness", "title": "Region"},
          {"field": "fte_per_100k", "title": "FTE per 100,000", "format": ".1f"},
          {"field": "fte", "title": "Raw FTE", "format": ",.0f"}
        ]
      }
    }
  ]
}
