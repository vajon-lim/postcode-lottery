{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 320,
  "background": null,
  "config": {
    "font": "Source Sans 3, system-ui, sans-serif",
    "view": {
      "stroke": null
    }
  },
  "data": {
    "url": "data/workforce_remoteness.csv"
  },
  "transform": [
    {"filter": "datum.fte > 0"}
  ],
  "mark": {
    "type": "point",
    "filled": true,
    "size": 80,
    "opacity": 0.75
  },
  "encoding": {
    "y": {
      "field": "remoteness",
      "type": "ordinal",
      "sort": [
        "Major Cities",
        "Inner Regional",
        "Outer Regional",
        "Remote",
        "Very Remote"
      ],
      "axis": {
        "title": null,
        "labelFont": "Source Sans 3, system-ui, sans-serif",
        "labelFontSize": 11
      }
    },
    "x": {
      "field": "fte",
      "type": "quantitative",
      "scale": {
        "type": "log",
        "base": 10
      },
      "axis": {
        "title": "Full-time equivalent (FTE, log scale)",
        "labelFont": "Source Sans 3, system-ui, sans-serif",
        "titleFont": "Source Sans 3, system-ui, sans-serif",
        "titleFontSize": 11,
        "format": ",.0f",
        "values": [10, 100, 1000, 10000, 100000]
      }
    },
    "color": {
      "field": "profession",
      "type": "nominal",
      "scale": {
        "range": [
          "#0077BB",
          "#33BBEE",
          "#EE7733",
          "#DDAA33",
          "#AA3377",
          "#009988",
          "#CC5500",
          "#555555"
        ]
      },
      "legend": {
        "title": "Profession",
        "titleFont": "Source Sans 3, system-ui, sans-serif",
        "labelFont": "Source Sans 3, system-ui, sans-serif",
        "orient": "right"
      }
    },
    "tooltip": [
      {
        "field": "profession",
        "title": "Profession"
      },
      {
        "field": "remoteness",
        "title": "Remoteness"
      },
      {
        "field": "fte",
        "title": "FTE",
        "format": ",.0f"
      },
      {
        "field": "headcount",
        "title": "Headcount",
        "format": ",.0f"
      },
      {
        "field": "avg_age",
        "title": "Avg age"
      }
    ]
  }
}